#!/usr/bin/env bash
# review-snapshot — freeze the review candidate BEFORE anything reads it.
#
# A review whose findings describe a tree that moved mid-review is unfalsifiable. This
# command writes a snapshot of the content under review (base ref, HEAD for context, the
# working-tree content fingerprint and the diff hash) so a reviewer/QA reports *against*
# that snapshot, and delivery can re-compute it and detect that the content moved.
#
# The comparison is CONTENT-based, never commit-identity-based: the fingerprint is
# `git write-tree` over the working tree (see bin/no-smoke-worktree), which is stable
# across rebase/amend/squash that preserve content. Comparing shas would block a
# legitimate history rewrite — exactly the false positive the fingerprint avoids.
#
# Read-only with respect to the repository: it never touches the index, the refs or any
# tracked file. It writes only the snapshot file named by --out.
#
# Concept adapted from Gentle-AI's frozen review candidate (Gentleman-Programming, MIT);
# implementation is native to this repo's bin/ pattern (bash + zero dependencies).
set -uo pipefail

usage() {
  cat <<'EOF'
Usage:
  review-snapshot [--base <ref>] [--out <path>]
  review-snapshot --compare <snapshot.json>

  --base <ref>     diff base (default: main)
  --out <path>     where to write the snapshot (default: reports/review-snapshot.json)
  --compare <file> re-compute the current content and compare it against a snapshot

Prints, for a snapshot run, the resolved base, HEAD, the content fingerprint and the
diff hash. With --compare it prints MATCH or MISMATCH naming both fingerprints; a
MISMATCH exits non-zero so a delivery step can fail on it.

Exit status: 0 when the snapshot was written or the comparison matched; 1 on a
comparison mismatch; 2 when the assessment could not be performed (not a repository,
unknown base, missing tool).
EOF
}

BASE="main"
OUT="reports/review-snapshot.json"
COMPARE=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --base) [ "$#" -ge 2 ] || { printf 'review-snapshot: --base requires a ref\n' >&2; exit 2; }; BASE="$2"; shift 2 ;;
    --base=*) BASE="${1#--base=}"; shift ;;
    --out) [ "$#" -ge 2 ] || { printf 'review-snapshot: --out requires a path\n' >&2; exit 2; }; OUT="$2"; shift 2 ;;
    --out=*) OUT="${1#--out=}"; shift ;;
    --compare) [ "$#" -ge 2 ] || { printf 'review-snapshot: --compare requires a path\n' >&2; exit 2; }; COMPARE="$2"; shift 2 ;;
    --compare=*) COMPARE="${1#--compare=}"; shift ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'review-snapshot: unknown argument %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

command -v git >/dev/null 2>&1 || { printf 'review-snapshot: cannot assess (git not found)\n' >&2; exit 2; }
TOP=$(git rev-parse --show-toplevel 2>/dev/null) || { printf 'review-snapshot: cannot assess (not a git repository)\n' >&2; exit 2; }

# Fingerprint first: this is the property the snapshot exists to record.
FINGERPRINT=$(cd "$TOP" && "$(dirname "$0")/no-smoke-worktree" 2>/dev/null) || FINGERPRINT=""
[ -n "$FINGERPRINT" ] || { printf 'review-snapshot: cannot assess (fingerprint could not be computed)\n' >&2; exit 2; }

HEAD_SHA=$(git -C "$TOP" rev-parse HEAD 2>/dev/null) || { printf 'review-snapshot: cannot assess (no HEAD)\n' >&2; exit 2; }

field() {
  # Extract a string field from a snapshot file without jq.
  sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$1" | head -n 1
}

if [ -n "$COMPARE" ]; then
  if [ ! -f "$COMPARE" ]; then
    printf 'review-snapshot: cannot assess (snapshot not found: %s)\n' "$COMPARE" >&2
    exit 2
  fi
  WAS=$(field "$COMPARE" fingerprint)
  if [ -z "$WAS" ]; then
    printf 'review-snapshot: cannot assess (snapshot has no fingerprint: %s)\n' "$COMPARE" >&2
    exit 2
  fi
  if [ "$WAS" = "$FINGERPRINT" ]; then
    printf 'MATCH    snapshot=%s current=%s\n' "$WAS" "$FINGERPRINT"
    exit 0
  fi
  printf 'MISMATCH snapshot=%s current=%s\n' "$WAS" "$FINGERPRINT"
  printf 'review-snapshot: the content moved since the review was recorded — the evidence belongs to different content\n' >&2
  exit 1
fi

# The diff hash must be measured over a real base; an unknown base is "cannot assess",
# never a silent empty diff.
if ! git -C "$TOP" rev-parse --verify --quiet "$BASE^{commit}" >/dev/null 2>&1; then
  printf 'review-snapshot: cannot assess (unknown base ref: %s)\n' "$BASE" >&2
  exit 2
fi

DIFF_HASH=$(git -C "$TOP" diff "$BASE...HEAD" 2>/dev/null | git -C "$TOP" hash-object --stdin 2>/dev/null) || DIFF_HASH=""
[ -n "$DIFF_HASH" ] || { printf 'review-snapshot: cannot assess (diff hash could not be computed)\n' >&2; exit 2; }

DIFF_LINES=$(git -C "$TOP" diff --numstat "$BASE...HEAD" 2>/dev/null | awk '{a+=$1; d+=$2} END {print a+0 "+" d+0}')

OUT_DIR=$(dirname "$OUT")
[ -d "$OUT_DIR" ] || mkdir -p "$OUT_DIR" || { printf 'review-snapshot: cannot write snapshot to %s\n' "$OUT" >&2; exit 2; }

cat > "$OUT" <<EOF
{
  "base": "$BASE",
  "head": "$HEAD_SHA",
  "fingerprint": "$FINGERPRINT",
  "diffHash": "$DIFF_HASH",
  "authoredLines": "$DIFF_LINES",
  "created": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

printf 'snapshot: %s\nbase:      %s\nhead:      %s\nfingerprint: %s\ndiffHash:  %s\nauthored:  %s\n' \
  "$OUT" "$BASE" "$HEAD_SHA" "$FINGERPRINT" "$DIFF_HASH" "$DIFF_LINES"
exit 0
